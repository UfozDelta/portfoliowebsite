# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.

# Upstash Redis. In Vercel: Storage tab > Upstash Redis > Connect. It adds these for you (the prefix you pick, such as STORAGE_, KV_ or UPSTASH_REDIS_).
# Without them the site shows the built-in content and the admin cannot save.
STORAGE_REST_API_URL=
STORAGE_REST_API_TOKEN=

# Password for /admin. Without it the admin is switched off. Use a long random string.
ADMIN_PASSWORD=

# Optional. Signs the admin login cookie. If empty, a key is derived from ADMIN_PASSWORD.
SESSION_SECRET=

# Your live domain, used for canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://example.com
